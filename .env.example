# ---- API worker configuration ----
# Copy this file to `.env` and fill in the values:  cp .env.example .env
# (.env is git-ignored; never commit real tokens.)

# REQUIRED — Apify API token (Apify Console → Settings → Integrations → API token)
APIFY_TOKEN=apify_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# REQUIRED — the deployed scraper actor to invoke, as "owner/actor-name"
APIFY_ACTOR_ID=xtracto/naver-scraper-actor

# OPTIONAL — HTTP server
PORT=3000
MAX_CONCURRENCY=10

# OPTIONAL — max seconds to wait for one actor run
APIFY_RUN_TIMEOUT_SECS=60

# ---- Scraper tuning (OPTIONAL) ----
# These belong to the actor (library/naver_scraper), NOT this worker. Set them on the
# actor in the Apify Console (actor → Settings → Environment variables) if you want to tune:
#   NAVER_TLS_PROFILE=safari17_0      # curl_cffi impersonation profile
#   NAVER_RACE=3                      # concurrent fresh-IP attempts per wave
#   NAVER_MAX_ATTEMPTS=6              # total attempts before giving up
#   NAVER_PROXY_COUNTRY=KR            # residential exit country
#   NAVER_TIMEOUT=20                  # per-request timeout (seconds)
